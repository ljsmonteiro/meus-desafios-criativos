# .gitignore para projeto de Machine Learning

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Datasets (não versionar arquivos de dados pesados)
*.csv
*.parquet
*.zip
*.tar.gz
data/

# Model artifacts
*.joblib
*.pkl
*.model

# OS generated
.DS_Store
Thumbs.db
